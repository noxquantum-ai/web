{
  "name": "noxquantum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview --port 5173"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "preact-render-to-string": "^6.8.0",
    "prettier": "^3.9.9",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "preact": "^11.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
